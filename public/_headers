# Cloudflare Pages serves this file as response headers. Nothing here changes
# how the app works; it limits what a compromised script could do.
#
# connect-src lists every origin the app talks to. If the Worker is deployed on
# its own origin (VITE_API_BASE), add it to connect-src, or the API calls fail
# silently with a console CSP error and the app falls back to the scripted scenes.
# MapLibre runs in a Web Worker created from a blob: URL, hence worker-src blob:.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; child-src blob:; font-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(), payment=(), usb=()
  X-Frame-Options: DENY

/venues.geojson
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable
